// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            BigInt   @id @default(autoincrement())
  nickname      String   @db.VarChar(50)
  anonToken     String   @unique @default(dbgenerated("gen_random_uuid()")) @map("anon_token") @db.Uuid
  scanCharges   Int      @default(5) @map("scan_charges")
  lastChargedAt DateTime @default(now()) @map("last_charged_at")
  createdAt     DateTime @default(now()) @map("created_at")

  scans           Scan[]
  eggs            Egg[]
  eggWalkSessions EggWalkSession[]
  userMonsters    UserMonster[]
  battleLogs      BattleLog[]
  userMissions    UserMission[]

  @@map("users")
}

model Monster {
  id          BigInt   @id @default(autoincrement())
  dexId       Int      @unique @map("dex_id")
  name        String   @db.VarChar(100)
  rarity      String   @db.VarChar(20)
  material    String   @db.VarChar(20)
  shape       String   @db.VarChar(20)
  dropWeight  Int      @map("drop_weight")
  baseHp      Int      @map("base_hp")
  baseAttack  Int      @map("base_attack")
  baseDefense Int      @map("base_defense")
  baseSpeed   Int      @map("base_speed")
  imageUrl        String   @map("image_url")        // 도감용 (배경 포함 원본 일러스트)
  cutoutImageUrl  String   @map("cutout_image_url") // 알 부화용 (누끼 이미지)
  isFallback  Boolean  @default(false) @map("is_fallback")
  createdAt   DateTime @default(now()) @map("created_at")

  eggs         Egg[]
  userMonsters UserMonster[]

  @@index([material, shape])
  @@map("monsters")
}

model RarityStepRequirement {
  rarity        String   @id @db.VarChar(20)
  requiredSteps Int      @map("required_steps")
  updatedAt     DateTime @default(now()) @map("updated_at")

  @@map("rarity_step_requirements")
}

model Scan {
  id                  BigInt   @id @default(autoincrement())
  userId              BigInt   @map("user_id")
  extractedAttributes Json     @map("extracted_attributes")
  material            String?  @db.VarChar(20)
  shape               String?  @db.VarChar(20)
  similarityScore     Decimal? @map("similarity_score") @db.Decimal(5, 2)
  blockReason         String   @default("NONE") @map("block_reason") @db.VarChar(20)
  createdAt           DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  egg  Egg?

  @@index([userId])
  @@index([material, shape])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("scans")
}

model Egg {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  scanId        BigInt    @unique @map("scan_id")
  monsterId     BigInt    @map("monster_id")
  requiredSteps Int       @map("required_steps")
  currentSteps  Int       @default(0) @map("current_steps")
  status        String    @default("INCUBATING") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")
  readyAt       DateTime? @map("ready_at")
  hatchedAt     DateTime? @map("hatched_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scan            Scan             @relation(fields: [scanId], references: [id])
  monster         Monster          @relation(fields: [monsterId], references: [id])
  eggWalkSessions EggWalkSession[]
  userMonsters    UserMonster[]

  @@index([userId, status])
  @@map("eggs")
}

model EggWalkSession {
  id            BigInt    @id @default(autoincrement())
  eggId         BigInt    @map("egg_id")
  userId        BigInt    @map("user_id")
  startedAt     DateTime  @default(now()) @map("started_at")
  lastActiveAt  DateTime  @default(now()) @map("last_active_at")
  endedAt       DateTime? @map("ended_at")
  stepsCaptured Int       @default(0) @map("steps_captured")
  endReason     String?   @map("end_reason") @db.VarChar(20)
  status        String    @default("ACTIVE") @db.VarChar(20)

  egg  Egg  @relation(fields: [eggId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eggId])
  @@index([userId, startedAt])
  @@map("egg_walk_sessions")
}

model UserMonster {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  monsterId     BigInt   @map("monster_id")
  eggId         BigInt?  @map("egg_id")
  catchCount    Int      @default(1) @map("catch_count")
  level         Int      @default(1)
  ivHp          Int      @default(0) @map("iv_hp")
  ivAttack      Int      @default(0) @map("iv_attack")
  ivDefense     Int      @default(0) @map("iv_defense")
  ivSpeed       Int      @default(0) @map("iv_speed")
  pendingIvHp      Int? @map("pending_iv_hp")
  pendingIvAttack  Int? @map("pending_iv_attack")
  pendingIvDefense Int? @map("pending_iv_defense")
  pendingIvSpeed   Int? @map("pending_iv_speed")
  firstCaughtAt DateTime @default(now()) @map("first_caught_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  monster Monster @relation(fields: [monsterId], references: [id])
  egg     Egg?    @relation(fields: [eggId], references: [id], onDelete: SetNull)

  battleLogs BattleLog[]

  @@unique([userId, monsterId])
  @@index([userId])
  @@map("user_monsters")
}

model Boss {
  id              BigInt   @id @default(autoincrement())
  dexId           Int      @unique @map("dex_id")
  name            String   @db.VarChar(100)
  imageUrl        String   @map("image_url")
  cutoutImageUrl  String   @map("cutout_image_url")
  hp              Int
  weakAttribute   String?  @map("weak_attribute") @db.VarChar(20)
  strongAttribute String?  @map("strong_attribute") @db.VarChar(20)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  battleLogs BattleLog[]

  @@map("bosses")
}

model BattleLog {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt   @map("user_id")
  bossId           BigInt   @map("boss_id")
  userMonsterId    BigInt   @map("user_monster_id")
  damageMultiplier Decimal  @default(1.0) @map("damage_multiplier") @db.Decimal(4, 2)
  damageDealt      Int      @map("damage_dealt")
  isCritical       Boolean  @default(false) @map("is_critical")
  bossHpRemaining  Int      @map("boss_hp_remaining")
  createdAt        DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  boss        Boss        @relation(fields: [bossId], references: [id])
  userMonster UserMonster @relation(fields: [userMonsterId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("battle_logs")
}

model Mission {
  id            BigInt   @id @default(autoincrement())
  code          String   @unique @db.VarChar(50)
  title         String   @db.VarChar(100)
  description   String?  @db.Text
  cycle         String   @db.VarChar(20)
  conditionType String   @map("condition_type") @db.VarChar(50)
  targetCount   Int      @map("target_count")
  conditionMeta Json?    @map("condition_meta")
  rewardType    String?  @map("reward_type") @db.VarChar(50)
  rewardAmount  Int?     @map("reward_amount")
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  userMissions UserMission[]

  @@map("missions")
}

model UserMission {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  missionId   BigInt    @map("mission_id")
  periodKey   String    @map("period_key") @db.VarChar(20)
  completedAt DateTime? @map("completed_at")
  claimedAt   DateTime? @map("claimed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id])

  @@unique([userId, missionId, periodKey])
  @@index([userId, periodKey])
  @@index([userId, completedAt])
  @@map("user_missions")
}